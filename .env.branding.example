# ============================================
# Leadfy — Branding Configuration
# ============================================
# Copy this file to .env.local and customize
# for each client deployment.
#
# All variables are optional — defaults are used
# when not set.
# ============================================

# App name (shown in sidebar, auth pages, <title>)
NEXT_PUBLIC_BRAND_NAME=Leadfy

# Logo URL (full URL to PNG/SVG, 120x40px recommended)
# Example: https://cdn.example.com/logo.png
NEXT_PUBLIC_BRAND_LOGO_URL=

# Primary brand color (hex with #)
# Used for buttons, links, accents in light mode
NEXT_PUBLIC_PRIMARY_COLOR=#000000

# Primary color for dark mode / light backgrounds
NEXT_PUBLIC_PRIMARY_COLOR_LIGHT=#ffffff

# Favicon URL (full URL to .ico or .png)
NEXT_PUBLIC_BRAND_FAVICON_URL=

# App URL (used in email links and share URLs)
NEXT_PUBLIC_APP_URL=https://xtask.space

# ============================================
# Database (Supabase)
# ============================================
DATABASE_URL=
DIRECT_URL=

# ============================================
# Auth (NextAuth)
# ============================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ============================================
# Email (Resend — optional)
# ============================================
# If not set, invitation emails show a link
# for manual sharing instead.
RESEND_API_KEY=
