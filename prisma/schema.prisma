// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id
  name         String?
  email        String         @unique
  password     String?
  image        String?
  createdAt    DateTime       @default(now())
  projects     ProjectMember[]
  tasks        Task[]         @relation("AssignedTasks")
  taskAssignees TaskAssignee[]
  createdTasks Task[]         @relation("CreatedTasks")
  comments     Comment[]      @relation("AuthorComments")
  accounts     Account[]
  sessions     Session[]
  sentInvitations Invitation[]   @relation("Inviter")
  createdInviteTokens ProjectInviteToken[] @relation("TokenCreator")
  notifications Notification[]
  timeEntries  TimeEntry[]
  emailConfig  EmailConfig?
  organizations OrganizationMember[]
  apiKeys      ApiKey[]
  resetTokens  PasswordResetToken[]
  metaConnection MetaConnection?
  gaConnection GoogleAnalyticsConnection?
  agentDocuments AgentDocument[]
}

model Project {
  id             String          @id
  name           String
  description    String?
  color          String          @default("#6366f1")
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  tasks          Task[]
  invitations    Invitation[]
  inviteTokens   ProjectInviteToken[]
  monthlyFee       Float           @default(0)
  clientContext    String?
  clientEmail      String?
  recurringInvoice Boolean         @default(false)
  billingDay       Int             @default(31)
  invoiceEmailMsg  String?
  billingConcept   String?
  invoices         Invoice[]
  labels           ProjectLabel[]
  taskPipelines    TaskPipeline[]
}

model ProjectMember {
  id        String  @id
  role      String  @default("MEMBER")
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
}

model Task {
  id            String         @id
  title         String
  description   String?
  status        String         @default("TODO")
  priority      String         @default("NONE")
  dueDate       DateTime?
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      User?          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId     String
  creator       User           @relation("CreatedTasks", fields: [creatorId], references: [id])
  parentId      String?
  parent        Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("Subtasks")
  tags          TaskTag[]
  comments      Comment[]
  attachments   Attachment[]
  timeEntries   TimeEntry[]
  taskAssignees TaskAssignee[]
  organizationId String?
  pipelineId    String?
  pipeline      TaskPipeline?   @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId       String?
  stage         TaskPipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  tdahMetrics   Json?
}

model TaskAssignee {
  id        String @id @default(cuid())
  taskId    String
  userId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model Comment {
  id        String   @id
  content   String
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthorComments", fields: [authorId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id
  name      String
  url       String
  type      String
  size      Int?
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTag {
  id     String @id
  name   String
  color  String @default("#6366f1")
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ========== INVITACIONES Y NOTIFICACIONES ==========

model Invitation {
  id             String    @id
  email          String
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      String
  inviter        User      @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  role           String    @default("MEMBER")
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
}

model ProjectInviteToken {
  id        String   @id
  token     String   @unique
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation("TokenCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  maxUses   Int?
  uses      Int      @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ========== TIME TRACKING ==========

model TimeEntry {
  id          String    @id
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // in seconds
  description String?
  createdAt   DateTime  @default(now())
}

// ========== TASK TEMPLATES ==========

model TaskTemplate {
  id             String        @id
  name           String
  title          String
  description    String?
  status         String        @default("TODO")
  priority       String        @default("NONE")
  tags           Json?
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========== ORGANIZACIONES ==========

model Organization {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  logo        String?
  apiKey          String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  billingName     String?
  billingTaxId    String?
  billingAddress  String?
  billingPhone    String?
  billingEmail    String?
  defaultIva      Float               @default(21)
  defaultIrpf     Float               @default(15)
  invoiceTemplate String              @default("modern")
  billingFooter   String?
  members         OrganizationMember[]
  projects        Project[]
  invitations     Invitation[]
  labels          Label[]
  knowledgeBase   KnowledgeBase?
  pipelines       Pipeline[]
  activities      Activity[]
  taskTemplates   TaskTemplate[]
  chatMessages    ChatMessage[]
  taskPipelines   TaskPipeline[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  role           String       @default("MEMBER")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([userId, organizationId])
}

// ========== EMAIL / IMAP ==========

// ========== API KEYS (OpenClaw) ==========

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  keyPrefix   String
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String    @default("full")  // read, write, admin, full
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  active      Boolean   @default(true)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  amount    Float
  concept   String?
  status    String    @default("PENDING")
  paidAt    DateTime?
  dueDate   DateTime
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([projectId, month, year])
}

model ChatMessage {
  id             String        @id @default(cuid())
  userId         String
  projectId      String?
  role           String        // "user" | "assistant" | "system"
  content        String
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?       // nullable: agent conversations (seo-agent, sem-agent, social-agent)
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ========== LABELS / TAGS ==========

model Label {
  id             String         @id @default(cuid())
  name           String
  color          String         @default("#6366f1")
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       ProjectLabel[]
  createdAt      DateTime       @default(now())

  @@unique([name, organizationId])
}

model ProjectLabel {
  id         String @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelId    String
  label      Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([projectId, labelId])
}

model KnowledgeBase {
  id             String   @id @default(cuid())
  content        String   @default("")
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model TaskyUsage {
  id             String   @id @default(cuid())
  organizationId String?
  projectId      String?
  userId         String
  prompt         String
  toolsUsed      String[]
  responseTokens Int?
  duration       Int      // milliseconds
  createdAt      DateTime @default(now())
}

// ========== CRM: CONTACTS, PIPELINE & DEALS ==========

model Contact {
  id             String     @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  notes          String?
  tags           String[]
  status         String     @default("LEAD")
  pipelineId     String?
  pipeline       Pipeline?  @relation(fields: [pipelineId], references: [id])
  deals          Deal[]
  activities     Activity[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ownerId        String?
  organizationId String?
}

model Pipeline {
  id             String          @id @default(cuid())
  name           String          @default("Ventas")
  isDefault      Boolean         @default(true)
  stages         PipelineStage[]
  deals          Deal[]
  contacts       Contact[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  id         String   @id @default(cuid())
  name       String
  position   Int
  color      String   @default("#6366f1")
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]
  createdAt  DateTime @default(now())

  @@unique([pipelineId, position])
}

model Deal {
  id            String        @id @default(cuid())
  title         String
  value         Float         @default(0)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id])
  probability   Int           @default(0)
  expectedClose DateTime?
  notes         String?
  activities    Activity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  movedAt       DateTime      @updatedAt
  ownerId       String?
  organizationId String?

}

model Activity {
  id             String        @id @default(cuid())
  type           String
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean       @default(false)
  completedAt    DateTime?
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ownerId        String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========== EMAIL / IMAP ==========

model EmailConfig {
  id                String   @id
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  host              String
  port              Int      @default(993)
  email             String
  encryptedPassword String
  ssl               Boolean  @default(true)
  smtpHost          String?
  smtpPort          Int?     @default(587)
  smtpSecure        Boolean? @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ========== INTEGRATIONS: META ADS ==========

model MetaConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  adAccountId   String?
  adAccountName String?
  status        String    @default("CONNECTED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ========== INTEGRATIONS: GOOGLE ANALYTICS ==========

model GoogleAnalyticsConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  propertyId   String?
  propertyName String?
  status       String    @default("CONNECTED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ========== INTEGRATION METRICS CACHE ==========

model IntegrationMetric {
  id            String   @id @default(cuid())
  userId        String
  source        String   // "META_ADS" | "GOOGLE_ANALYTICS"
  metricName    String   // "spend", "impressions", "clicks", "sessions", etc.
  metricValue   Float
  metricDate    DateTime // fecha a la que corresponde la métrica
  metadata      Json?    // datos adicionales
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, source, metricDate])
}
model AgentDocument {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int?
  text      String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
}

model TaskPipeline {
  id             String              @id @default(cuid())
  name           String
  isDefault      Boolean             @default(false)
  stages         TaskPipelineStage[]
  tasks          Task[]
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model TaskPipelineStage {
  id         String       @id @default(cuid())
  name       String
  position   Int
  color      String       @default("#6366f1")
  pipelineId String
  pipeline   TaskPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  tasks      Task[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([pipelineId, position])
}

