# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL / Neon / Supabase / Railway)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/leadfy?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/leadfy"

# -----------------------------------------------------------------------------
# Autenticación y URLs Base (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="genera-un-secret-aleatorio-largo-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Leadfy"

# -----------------------------------------------------------------------------
# Seguridad & Criptografía
# -----------------------------------------------------------------------------
# Clave fija de exactamente 32 bytes para cifrar contraseñas IMAP/SMTP en base de datos
EMAIL_ENCRYPTION_KEY="genera-una-clave-aes-256-de-32-chars-exactos!"

# Token secreto para proteger llamadas a endpoints cron automáticos
CRON_SECRET="genera-un-secret-para-cron-jobs"

# -----------------------------------------------------------------------------
# Almacenamiento de Archivos (Adjuntos y Facturas)
# -----------------------------------------------------------------------------
# Token de lectura/escritura de Vercel Blob (o compatible)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# -----------------------------------------------------------------------------
# Proveedores de Inteligencia Artificial (Agentes, TDAH, Mapas Mentales)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-..."

# -----------------------------------------------------------------------------
# Servicio de Correos Transaccionales (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@tudominio.com"

# -----------------------------------------------------------------------------
# Documentación & Métricas Internas (Opcional)
# -----------------------------------------------------------------------------
INNIX_DOC_KEY="clave-de-acceso-para-metricas-doc-usage"
